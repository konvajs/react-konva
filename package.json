{
  "license": "MIT",
  "name": "react-konva",
  "description": "React components for the Konva 2d canvas library. Build interactive graphics, design editors, and whiteboards with JSX.",
  "keywords": [
    "react",
    "canvas",
    "jsx",
    "konva",
    "graphics",
    "design-editor",
    "canvas-editor",
    "whiteboard",
    "transformer"
  ],
  "homepage": "https://konvajs.org/docs/react/index.html",
  "version": "19.3.0",
  "bugs": "https://github.com/konvajs/react-konva/issues",
  "main": "lib/ReactKonva.js",
  "module": "es/ReactKonva.js",
  "exports": {
    ".": {
      "import": {
        "types": "./es/ReactKonvaCore.d.ts",
        "default": "./es/ReactKonva.js"
      },
      "require": {
        "types": "./lib/ReactKonvaCore.d.ts",
        "default": "./lib/ReactKonva.js"
      }
    },
    "./lib/*.js": {
      "import": "./es/*.js",
      "require": "./lib/*.js"
    },
    "./lib/*.d.ts": "./lib/*.d.ts",
    "./lib/*": {
      "import": "./es/*.js",
      "require": "./lib/*.js"
    },
    "./es/*.js": "./es/*.js",
    "./es/*.d.ts": "./es/*.d.ts",
    "./es/package.json": "./es/package.json",
    "./es/*": "./es/*.js",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/konvajs/react-konva.git"
  },
  "dependencies": {
    "@types/react-reconciler": "^0.33.0",
    "its-fine": "^2.0.0",
    "react-reconciler": "0.34.0",
    "scheduler": "0.28.0"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/lavrton"
    },
    {
      "type": "opencollective",
      "url": "https://opencollective.com/konva"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/lavrton"
    }
  ],
  "peerDependencies": {
    "konva": "^8.0.1 || ^7.2.5 || ^9.0.0 || ^10.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "konva": "latest",
    "mobx": "^6.13.5",
    "mobx-react-lite": "^4.1.0",
    "playwright": "^1.58.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "use-image": "^1.1.4",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "test:typings": "tsc --noEmit && tsc -p test/types/tsconfig.json",
    "preversion": "npm test",
    "version": "npm run build",
    "test": "npm run test:browser && npm run test:performance && npm run test:ssr && npm run test:typings",
    "test:browser": "vitest run && npm run test:prod",
    "test:performance": "NODE_ENV=production vitest run --config benchmarks/vitest.counts.config.mts",
    "test:prod": "NODE_ENV=production vitest run",
    "test:ssr": "npm run build && node --no-experimental-detect-module test/11-ssr.mjs && node test/24-package-exports.mjs && node test/29-devtools.mjs",
    "bench:events": "node benchmarks/run.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:debug": "HEADLESS=false vitest"
  },
  "typings": "ReactKonvaCore.d.ts",
  "files": [
    "README.md",
    "docs/react-compatibility.md",
    "RELEASE_NOTES.md",
    "lib",
    "es",
    "ReactKonvaCore.d.ts"
  ]
}
